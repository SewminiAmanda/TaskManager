
<partial name="_Notification" />
<div class="container">
	<div class="row pt-4">
		<div class="col-6">
			<h2 class="text-primary">
				Task List
			</h2>
		</div>
		<div class="col-6 text-end">
			<a asp-controller="Task" asp-action="Create" class="btn btn-primary">
				<i class="bi bi-plus-circle"></i> Create New Task
			</a>
		</div>

	</div>

	<br /> <br />


<ul>
	@foreach (var task in Model)
	{

		<div class="card bg-secondary mb-3" style="max-width: 60rem;" asp-controller="Task" asp-action="Details" asp-route-id="@task.TaskID">
				<div class="card-header" >
					<a asp-controller="Task" asp-action="Details" asp-route-id="@task.TaskID">@task.Title</a>
					
				</div>
			</div>
	}
</ul>

</div>
